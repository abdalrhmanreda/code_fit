{
    "version": 8,
    "name": "CodeFit Premium Light",
    "metadata": {
        "maputnik:renderer": "mlgljs"
    },
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "https://tiles.openfreemap.org/vector.json"
        }
    },
    "sprite": "https://tiles.openfreemap.org/sprites/osm-liberty",
    "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#FFFFFF"
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "filter": [
                "==",
                "$type",
                "Polygon"
            ],
            "paint": {
                "fill-color": "#F0F9FF"
            }
        },
        {
            "id": "landuse_residential",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "filter": [
                "==",
                "class",
                "residential"
            ],
            "paint": {
                "fill-color": "#FAFAFA"
            }
        },
        {
            "id": "landcover_grass",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "filter": [
                "==",
                "class",
                "grass"
            ],
            "paint": {
                "fill-color": "#F9FAFB"
            }
        },
        {
            "id": "road_major",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "primary"
            ],
            "paint": {
                "line-color": "#F1F5F9",
                "line-width": {
                    "base": 1.4,
                    "stops": [
                        [
                            10,
                            1
                        ],
                        [
                            20,
                            10
                        ]
                    ]
                }
            }
        },
        {
            "id": "road_minor",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "in",
                "class",
                "street",
                "service"
            ],
            "paint": {
                "line-color": "#F8FAFC",
                "line-width": {
                    "base": 1.2,
                    "stops": [
                        [
                            10,
                            0.5
                        ],
                        [
                            20,
                            5
                        ]
                    ]
                }
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "building",
            "paint": {
                "fill-color": "#F1F5F9",
                "fill-opacity": 0.5
            }
        },
        {
            "id": "place_label",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "place",
            "layout": {
                "text-field": "{name:latin}",
                "text-font": [
                    "Open Sans Regular"
                ],
                "text-size": {
                    "stops": [
                        [
                            0,
                            10
                        ],
                        [
                            10,
                            14
                        ]
                    ]
                },
                "text-transform": "uppercase",
                "text-letter-spacing": 0.1
            },
            "paint": {
                "text-color": "#3B82F6",
                "text-halo-color": "#FFFFFF",
                "text-halo-width": 2
            }
        },
        {
            "id": "road_label",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation_name",
            "layout": {
                "text-field": "{name:latin}",
                "text-font": [
                    "Roboto Regular"
                ],
                "text-size": 10,
                "symbol-placement": "line"
            },
            "paint": {
                "text-color": "#94A3B8",
                "text-halo-color": "#FFFFFF",
                "text-halo-width": 1
            }
        }
    ]
}